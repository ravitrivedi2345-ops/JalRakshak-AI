APP_NAME=JalRakshak AI Backend
APP_ENV=development
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./jalrakshak.db
# For PostgreSQL + PostGIS deployment:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jalrakshak

JWT_SECRET_KEY=jalrakshak_super_secret_jwt_key_2026_change_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8443,http://127.0.0.1:8443,http://localhost:3000

UPLOAD_DIR=./storage/uploads
OUTPUT_DIR=./storage/outputs
MAX_UPLOAD_SIZE_MB=15

REDIS_URL=redis://localhost:6379/0

SATELLITE_PROVIDER=mock
SATELLITE_API_URL=
SATELLITE_API_TOKEN=

AI_MODEL_PATH=./ml/models/intervention_detector.pt

# Google Gemini AI — set your key in .env (never commit the real key)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
