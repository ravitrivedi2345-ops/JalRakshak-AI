APP_NAME=JalRakshak AI Backend
APP_ENV=development
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./jalrakshak.db
# For Production PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/jalrakshak_db

JWT_SECRET_KEY=jalrakshak_super_secret_jwt_key_2026_change_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8443,http://127.0.0.1:8443,http://localhost:3000,https://*.vercel.app,https://*.onrender.com

UPLOAD_DIR=./storage/uploads
OUTPUT_DIR=./storage/outputs
MAX_UPLOAD_SIZE_MB=15

REDIS_URL=redis://localhost:6379/0

# Satellite Provider Credentials (Sentinel Hub & Google Earth Engine)
SATELLITE_PROVIDER=sentinel-hub # sentinel-hub, gee, or mock
SATELLITE_API_URL=https://services.sentinel-hub.com/ogc/wms
SATELLITE_API_TOKEN=your_sentinel_api_token_here
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret_here
SENTINEL_HUB_INSTANCE_ID=your_sentinel_hub_instance_id_here

# Google Earth Engine Credentials (Optional)
GEE_SERVICE_ACCOUNT=your_gee_service_account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

AI_MODEL_PATH=./ml/models/intervention_detector.pt

# Google Gemini AI — set your key in .env (never commit the real key)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

