# Vercel Function Bundle Ignore File
# Exclude heavy frontend assets, node_modules, database files, and local venvs from Python serverless functions

node_modules
frontend/node_modules
dist
.git
.venv
backend/.venv
storage
backend/storage
jalrakshak.db
backend/jalrakshak.db
.pytest_cache
backend/.pytest_cache
*.pyc
__pycache__
ml/models/*.pt
backend/ml/models/*.pt
pnpm-lock.yaml
package-lock.json
*.log
